---
import { Icon } from 'astro-icon/components';

type AwardItem = {
  title: string;
  granter: string;
  date: Date | string;
  icon?: string;
  highlight?: boolean;
};

interface Props {
  items: AwardItem[];
  initial?: number;
}

const { items, initial } = Astro.props;

const iconName = (raw: string | undefined): string => {
  if (!raw) return 'tabler:award';
  if (raw.includes(':')) return raw;
  return `tabler:${raw}`;
};

const toDate = (v: Date | string): Date => (v instanceof Date ? v : new Date(v));
const formatDate = (v: Date | string): string =>
  toDate(v).toLocaleString('en-US', { month: 'short', year: 'numeric' });

const sorted = [...items].sort(
  (a, b) => toDate(b.date).getTime() - toDate(a.date).getTime(),
);

const showCount = initial && sorted.length > initial ? initial : sorted.length;
const visible = sorted.slice(0, showCount);
const hidden = sorted.slice(showCount);
---

<section aria-labelledby="awards-heading">
  <h2 id="awards-heading">Awards &amp; Scholarships</h2>
  <ul class="awards-list">
    {visible.map((item) => (
      <li class:list={[{ 'is-highlight': item.highlight }]}>
        <span class="award-icon" aria-hidden="true">
          <Icon name={iconName(item.icon)} />
        </span>
        <span class="award-body">
          <span class="award-title">{item.title}</span>
          <span class="award-meta meta">{item.granter} · {formatDate(item.date)}</span>
        </span>
      </li>
    ))}
  </ul>
  {hidden.length > 0 && (
    <details class="awards-more">
      <summary class="see-all">
        <span class="awards-toggle-closed">see all awards →</span>
        <span class="awards-toggle-open">show less ↑</span>
      </summary>
      <ul class="awards-list awards-list-extra">
        {hidden.map((item) => (
          <li class:list={[{ 'is-highlight': item.highlight }]}>
            <span class="award-icon" aria-hidden="true">
              <Icon name={iconName(item.icon)} />
            </span>
            <span class="award-body">
              <span class="award-title">{item.title}</span>
              <span class="award-meta meta">{item.granter} · {formatDate(item.date)}</span>
            </span>
          </li>
        ))}
      </ul>
    </details>
  )}
</section>

<style>
  h2 { margin-bottom: 0.85rem; }
  .awards-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .awards-list li {
    display: grid;
    grid-template-columns: 28px 1fr;
    column-gap: 0.75rem;
    align-items: center;
  }
  .award-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--surface-subtle);
    border-radius: 6px;
    color: var(--text-secondary);
  }
  .award-icon :global(svg) {
    width: 16px;
    height: 16px;
  }
  .award-body {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    line-height: 1.4;
  }
  .award-title {
    color: var(--text);
  }
  .awards-list li.is-highlight {
    background: var(--highlight-bg);
    border-radius: 6px;
    padding: 0.4rem 0.6rem;
    margin: -0.35rem -0.6rem;   /* horizontal margin cancels padding so the icon stays aligned */
  }
  .awards-more {
    display: flex;
    flex-direction: column;
  }
  .awards-more > summary {
    order: 1;
    cursor: pointer;
    list-style: none;
  }
  .awards-more > summary::-webkit-details-marker {
    display: none;
  }
  .awards-more[open] .awards-toggle-closed,
  .awards-more:not([open]) .awards-toggle-open {
    display: none;
  }
  .awards-list-extra {
    margin-top: 0.7rem;
  }
</style>
