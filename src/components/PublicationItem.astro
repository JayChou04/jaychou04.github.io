---
import { Icon } from 'astro-icon/components';
import { isOwner } from '@lib/authors';

type PubLinks = {
  paper?: string;
  code?: string;
  video?: string;
  dataset?: string;
  project?: string;
};

type Publication = {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  thumbnail?: string;
  links?: PubLinks;
  bibtex?: string;
  tags?: string[];
  highlight?: boolean;
};

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
const id = `bib-${pub.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<article class:list={['pub-item', { 'is-highlight': pub.highlight, 'no-thumb': !pub.thumbnail }]}>
  {pub.thumbnail && (
    <div class="pub-thumb">
      <img src={pub.thumbnail} alt="" loading="lazy" />
    </div>
  )}
  <div class="pub-body">
    <h3 class="pub-title">
      {pub.links?.project ? (
        <a
          href={pub.links.project}
          target={pub.links.project.startsWith('http') ? '_blank' : undefined}
          rel={pub.links.project.startsWith('http') ? 'noopener' : undefined}
        >{pub.title}</a>
      ) : pub.title}
    </h3>
    <p class="pub-authors">
      {pub.authors.map((author, i) => (
        <>
          {isOwner(author) ? <strong>{author}</strong> : <span>{author}</span>}{i < pub.authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
    <p class="pub-meta meta">{pub.venue} · {pub.year}</p>
    <div class="pub-actions">
      {pub.links?.paper && (
        <a class="action-button" href={pub.links.paper} target="_blank" rel="noopener">
          <Icon name="tabler:file-text" /> paper
        </a>
      )}
      {pub.links?.code && (
        <a class="action-button" href={pub.links.code} target="_blank" rel="noopener">
          <Icon name="tabler:brand-github" /> code
        </a>
      )}
      {pub.links?.video && (
        <a class="action-button" href={pub.links.video} target="_blank" rel="noopener">
          <Icon name="tabler:player-play" /> video
        </a>
      )}
      {pub.links?.project && (
        <a
          class="action-button"
          href={pub.links.project}
          target={pub.links.project.startsWith('http') ? '_blank' : undefined}
          rel={pub.links.project.startsWith('http') ? 'noopener' : undefined}
        >
          <Icon name="tabler:layout-grid" /> project
        </a>
      )}
      {pub.links?.dataset && (
        <a class="action-button" href={pub.links.dataset} target="_blank" rel="noopener">
          <Icon name="tabler:database" /> dataset
        </a>
      )}
      {pub.bibtex && (
        <button class="action-button" type="button" data-bibtex-toggle={id}>
          <Icon name="tabler:quote" /> bibtex
        </button>
      )}
    </div>
    {pub.bibtex && (
      <pre id={id} class="pub-bibtex" hidden>{pub.bibtex.trim()}</pre>
    )}
  </div>
</article>

<style>
  .pub-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 0.5px solid var(--border);
  }
  .pub-item:last-child {
    border-bottom: none;
  }
  .pub-item.is-highlight {
    background: var(--highlight-bg);
    border-radius: 6px;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    margin-left: -0.75rem;
    margin-right: -0.75rem;
  }
  .pub-item.no-thumb {
    grid-template-columns: 1fr;
  }
  .pub-thumb {
    aspect-ratio: 16 / 9;
    background: var(--surface-subtle);
    border-radius: 6px;
    overflow: hidden;
  }
  .pub-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pub-body { min-width: 0; }
  .pub-title {
    margin-bottom: 0.2rem;
  }
  .pub-title a { color: var(--text); }
  .pub-title a:hover { color: var(--link); }
  .pub-authors {
    margin: 0 0 0.1rem;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .pub-authors strong { color: var(--text); font-weight: 600; }
  .pub-meta { margin: 0 0 0.55rem; }
  .pub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pub-bibtex {
    margin-top: 0.6rem;
    font-size: 12px;
  }
  @media (max-width: 640px) {
    .pub-item {
      grid-template-columns: 1fr;
    }
    .pub-thumb { max-width: 200px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-bibtex-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-bibtex-toggle');
      if (!id) return;
      const pre = document.getElementById(id);
      if (!pre) return;
      pre.hidden = !pre.hidden;
    });
  });
</script>
