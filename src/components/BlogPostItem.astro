---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, read_time, highlight, coming_soon } = post.data;

const formatDate = (d: Date): string =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<article class:list={['blog-item', { 'is-highlight': highlight, 'is-coming-soon': coming_soon }]}>
  {coming_soon && <span class="coming-badge">Coming Soon</span>}
  <h3 class="blog-title">
    {coming_soon ? title : <a href={`/blog/${post.id}`}>{title}</a>}
  </h3>
  {!coming_soon && (
    <p class="blog-meta meta">
      {formatDate(date)}{read_time ? ` · ${read_time} min read` : ''}
    </p>
  )}
  <p class="blog-desc">{description}</p>
</article>

<style>
  .blog-item {
    padding: 0.6rem 0;
    border-bottom: 0.5px solid var(--border);
  }
  .blog-item:last-child { border-bottom: none; }
  .blog-item.is-highlight {
    background: var(--highlight-bg);
    border-radius: 6px;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    margin-left: -0.75rem;
    margin-right: -0.75rem;
  }
  .blog-item.is-coming-soon {
    opacity: 0.75;
  }
  .blog-title {
    margin-bottom: 0.2rem;
  }
  .blog-title a { color: var(--text); }
  .blog-title a:hover { color: var(--link); }
  .blog-meta { margin: 0 0 0.2rem; }
  .blog-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
  }
  .coming-badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 0.2rem;
  }
</style>
