---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import AwardsList from '@components/AwardsList.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import PublicationList from '@components/PublicationList.astro';
import BlogList from '@components/BlogList.astro';

import { getCollection } from 'astro:content';
import awards from '@data/awards.yaml';
import publications from '@data/publications.yaml';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const featuredPubs = (publications as any[])
  .filter((p) => p.featured)
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

---

<BaseLayout>
  <Hero />
  <AwardsList items={awards as any[]} initial={3} />

  <section>
    <h2>Selected publications</h2>
    {featuredPubs.length > 0
      ? <PublicationList items={featuredPubs} />
      : <p class="muted">No featured publications yet.</p>}
    <a href="/publications" class="see-all">see all publications →</a>
  </section>

  <section>
    <h2>Selected projects</h2>
    {projects.length > 0
      ? <ProjectGrid projects={projects} />
      : <p class="muted">No featured projects yet.</p>}
    <a href="/projects" class="see-all">see all projects →</a>
  </section>

  <section>
    <h2>Recent posts</h2>
    {posts.length > 0
      ? <BlogList items={posts} />
      : <p class="muted">No posts yet.</p>}
    <a href="/blog" class="see-all">see all posts →</a>
  </section>
</BaseLayout>
