---
import PaperLayout from '@layouts/PaperLayout.astro';
import projects from '@data/projects.yaml';

const meta = (projects as any[]).find((p) => p.slug === 'example');
---

<PaperLayout
  title={meta.title}
  authors={meta.authors}
  venue={meta.venue}
  date={meta.date}
  links={meta.links}
  bibtex={meta.bibtex}
>
  <img class="teaser" src="/placeholder.svg" alt="Teaser figure" />

  <h2>Abstract</h2>
  <p>
    This page is a hand-written <code>.astro</code> template — copy the file at
    <code>src/pages/projects/example.astro</code> to start a new project page. You get full
    HTML and CSS control over everything inside the body, while the site navigation, paper
    header (title, authors, venue, and action buttons), and the BibTeX block at the bottom are
    all supplied automatically by the shared <code>PaperLayout</code>.
  </p>

  <h2>Method</h2>
  <p>
    Swap in your own figures, prose, and layout below the abstract — the two-column figure
    grid and results table are just plain HTML elements styled with a scoped
    <code>&lt;style&gt;</code> block, so nothing here is special-cased by the framework.
  </p>

  <div class="two-col">
    <figure><img src="/placeholder.svg" alt="" /><figcaption>Left: figure A.</figcaption></figure>
    <figure><img src="/placeholder.svg" alt="" /><figcaption>Right: figure B.</figcaption></figure>
  </div>

  <h2>Results</h2>
  <table class="results">
    <thead><tr><th>Method</th><th>Metric ↑</th><th>Error ↓</th></tr></thead>
    <tbody>
      <tr><td>Baseline</td><td>0.81</td><td>0.14</td></tr>
      <tr><td><strong>Ours</strong></td><td><strong>0.93</strong></td><td><strong>0.07</strong></td></tr>
    </tbody>
  </table>

  <!--
    To use a hero video instead of an image, drop an mp4 in /public and swap the teaser for:
    <video src="/projects/example/demo.mp4" autoplay loop muted playsinline></video>
  -->

  <style>
    .teaser { width: 100%; border-radius: 10px; margin-bottom: 1.5rem; }
    h2 { margin: 1.6rem 0 0.6rem; }
    p { margin: 0.6rem 0; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0; }
    .two-col figure { margin: 0; }
    .two-col img { width: 100%; border-radius: 8px; }
    .two-col figcaption { font-size: 12px; color: var(--text-secondary); margin-top: 0.4rem; }
    .results { width: 100%; border-collapse: collapse; margin: 0.5rem 0; font-size: 14px; }
    .results th, .results td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 0.5px solid var(--border); }
    .results thead th { color: var(--text-secondary); font-weight: 500; }
    @media (max-width: 640px) { .two-col { grid-template-columns: 1fr; } }
  </style>
</PaperLayout>
