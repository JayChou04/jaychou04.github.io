---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PublicationList from '@components/PublicationList.astro';
import publications from '@data/publications.yaml';
import site from '@data/site.yaml';

type Pub = {
  title: string;
  authors: string[];
  note?: string;
  venue: string;
  year: number;
  thumbnail?: string;
  links?: Record<string, string>;
  bibtex?: string;
  tags?: string[];
  featured?: boolean;
};

const allPubs = publications as Pub[];

const grouped = allPubs.reduce<Record<number, Pub[]>>((acc, pub) => {
  (acc[pub.year] ??= []).push(pub);
  return acc;
}, {});
const years = Object.keys(grouped).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="Publications">
  <header class="page-header">
    <h1>Publications</h1>
    {site.socials?.scholar && (
      <p class="scholar-link">
        <a href={site.socials.scholar} target="_blank" rel="noopener">
          <Icon name="tabler:external-link" /> Full list on Google Scholar
        </a>
      </p>
    )}
  </header>

  {years.map((year) => (
    <section class="year-section">
      <h3>{year}</h3>
      <PublicationList items={grouped[year]} />
    </section>
  ))}
</BaseLayout>

<style>
  .page-header h1 { margin: 0 0 0.35rem; }
  .scholar-link {
    margin: 0;
    font-size: 14px;
  }
  .scholar-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .scholar-link :global(svg) { width: 14px; height: 14px; }
  .year-section h3 {
    margin-bottom: 0.4rem;
    color: var(--text-secondary);
  }
</style>
