---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import { isOwner } from '@lib/authors';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, date, venue, authors, hero_video, hero_image, links, bibtex } = project.data;

const formattedDate = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={`${title} — ${venue ?? formattedDate}`}>
  <a href="/projects" class="back-link">
    <Icon name="tabler:arrow-left" /> back to projects
  </a>

  <header class="project-header">
    <h1>{title}</h1>
    <p class="project-authors">
      {authors.map((author, i) => (
        <>
          {isOwner(author) ? <strong>{author}</strong> : <span>{author}</span>}{i < authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
    <p class="project-meta meta">{venue ? `${venue} · ${formattedDate}` : formattedDate}</p>
    <div class="project-actions">
      {links?.paper && (
        <a class="action-button" href={links.paper} target="_blank" rel="noopener">
          <Icon name="tabler:file-text" /> paper
        </a>
      )}
      {links?.code && (
        <a class="action-button" href={links.code} target="_blank" rel="noopener">
          <Icon name="tabler:brand-github" /> code
        </a>
      )}
      {links?.video && (
        <a class="action-button" href={links.video} target="_blank" rel="noopener">
          <Icon name="tabler:player-play" /> video
        </a>
      )}
      {links?.dataset && (
        <a class="action-button" href={links.dataset} target="_blank" rel="noopener">
          <Icon name="tabler:database" /> dataset
        </a>
      )}
    </div>
  </header>

  {hero_video && (
    <div class="hero-media">
      <video src={hero_video} autoplay loop muted playsinline />
    </div>
  )}
  {!hero_video && hero_image && (
    <div class="hero-media">
      <img src={hero_image} alt="" />
    </div>
  )}

  <article class="prose">
    <slot />
  </article>

  {bibtex && (
    <section class="bibtex-section">
      <h2>BibTeX</h2>
      <pre>{bibtex.trim()}</pre>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .back-link:hover { color: var(--text); }
  .back-link :global(svg) {
    width: 14px;
    height: 14px;
  }

  .project-header > * + * {
    margin-top: 0.5rem;
  }
  .project-header h1 { margin: 0; }
  .project-authors {
    margin: 0;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .project-authors strong { color: var(--text); font-weight: 600; }
  .project-meta { margin: 0; }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem !important;
  }

  .hero-media {
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface-subtle);
  }
  .hero-media video,
  .hero-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .bibtex-section h2 { margin-bottom: 0.6rem; }
  .bibtex-section pre { font-size: 12px; }
</style>
